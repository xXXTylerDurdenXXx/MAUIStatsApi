<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIStatsApi.View.RegisterPage"
             Title="Регистрация">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="12">

            <Label Text="Регистрация" FontSize="26" />

            <Entry Placeholder="Логин" Text="{Binding Login}" />
            <Entry Placeholder="Email" Text="{Binding Email}" />
            <Entry Placeholder="Пароль" IsPassword="True" Text="{Binding Password}" />

            <Picker
                Title="Роль"
                ItemsSource="{Binding Roles}"
                SelectedItem="{Binding SelectedRole}"
                ItemDisplayBinding="{Binding Name}" />

            <Button
                Text="Зарегистрироваться"
                Command="{Binding RegisterCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>